    "qa:data-controls": "node scripts/verify-data-controls.mjs",
    "qa:store-readiness": "node scripts/verify-store-readiness.mjs",
    "qa:release": "node scripts/verify-release-config.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
