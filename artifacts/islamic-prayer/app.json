{
  "expo": {
    "name": "Nuur",
    "slug": "nuur",
    "owner": "nuurapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nuur",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#09150D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuur.islamicprayer",
      "buildNumber": "2",
      "entitlements": {
        "com.apple.developer.weatherkit": true,
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.com.nuur.shared"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nuur uses your location to calculate accurate prayer times, determine your Qibla direction, and find nearby mosques.",
        "NSPhotoLibraryAddUsageDescription": "Nuur saves Quranic verse cards you share to your Camera Roll.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "package": "com.nuur.islamicprayer",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withLocalNotificationsOnly",
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_makkah.wav",
            "./assets/sounds/adhan_madinah.wav",
            "./assets/sounds/adhan_afasy.wav",
            "./assets/sounds/adhan_egyptian.wav",
            "./assets/sounds/adhan_turkish.wav"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nuur uses your location to calculate accurate prayer times, determine your Qibla direction, and find nearby mosques.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Nuur saves Quranic verse cards you share to your Camera Roll.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a884ac11-7548-4c3a-9b03-da8203c70865"
      }
    }
  }
}
