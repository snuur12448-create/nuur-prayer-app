{
  "expo": {
    "name": "Nuur",
    "slug": "nuur",
    "owner": "nuurapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nuur",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#09150D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuur.islamicprayer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to calculate accurate prayer times for your area.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to calculate accurate prayer times for your area.",
        "NSPhotoLibraryUsageDescription": "Nuur saves your shared ayah cards to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Nuur saves your shared ayah cards to your photo library.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nuur.islamicprayer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_makkah.caf",
            "./assets/sounds/adhan_madinah.caf",
            "./assets/sounds/adhan_afasy.caf",
            "./assets/sounds/adhan_egyptian.caf",
            "./assets/sounds/adhan_turkish.caf",
            "./assets/sounds/adhan_silent.caf"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nuur to access your location to calculate accurate prayer times.",
          "locationAlwaysAndWhenInUsePermission": "Allow Nuur to access your location to calculate accurate prayer times."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Nuur saves your shared ayah cards to your photo library.",
          "savePhotosPermission": "Nuur saves your shared ayah cards to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a884ac11-7548-4c3a-9b03-da8203c70865"
      }
    }
  }
}
